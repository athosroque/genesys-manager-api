# Ambiente e Cookies
# development: cookie SameSite=Lax, Secure=False (HTTP local)
# production: cookie SameSite=None, Secure=True; defina COOKIE_DOMAIN se precisar
#             (ex.: .projetoathos.com.br). Deixe vazio no Docker Compose local.
ENVIRONMENT=development
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:8082

# Genesys Cloud Credentials (somente backend — nunca no frontend)
# Obtenha em: Admin > Integrations > OAuth (Client Credentials)
# Para presença na Consulta: inclua o scope analytics:readonly no client
# e permissão de analytics user detail na role/divisões (FGAC).
GENESYS_CLIENT_ID=seu_client_id_aqui
GENESYS_CLIENT_SECRET=seu_client_secret_aqui
GENESYS_REGION=sae1.pure.cloud

# Autenticação Local (JWT) — idle timeout 48h (sliding session)
# Gere uma chave segura com: openssl rand -hex 32
JWT_SECRET_KEY=sua_chave_secreta_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=2880

# Magic link (Resend) — usado só pelo backend Python (nunca no frontend/Vue)
# 1) Crie a API key em https://resend.com/api-keys
# 2) Substitua re_xxxxxxxxx pela chave real (começa com re_)
# 3) O backend só envia TO para @{ALLOWED_EMAIL_DOMAIN} (ex.: @claro.com.br).
#    Destinatários fora desse domínio são rejeitados antes de chamar o Resend.
# 4) Sandbox (onboarding@resend.dev): o Resend SÓ envia para o e-mail
#    dono da conta. Envio para @claro.com.br retorna 403 até você:
#      a) verificar um domínio em https://resend.com/domains
#      b) mudar RESEND_FROM_EMAIL para um endereço desse domínio
#    Ex.: Genesys Manager <noreply@projetoathos.com.br>
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Genesys Manager <noreply@projetoathos.com.br>
# URL pública que os usuários abrem (magic link + redirect pós-verify).
# Produção: https://genesys.projetoathos.com.br
# Compose local pode sobrescrever (ex.: http://localhost:8082) via environment.
APP_BASE_URL=https://genesys.projetoathos.com.br
ALLOWED_EMAIL_DOMAIN=claro.com.br
MAGIC_LINK_EXPIRE_MINUTES=10
